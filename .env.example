# Copy to .env (in this directory or its parent) and fill in.
ZILLIZ_URI=https://<cluster-endpoint>
ZILLIZ_TOKEN=<api-key-or-user:password>
ZILLIZ_DB=default

# Optional
# CLUSTER_DB_VERSION=v3.0.2   # exact build from the Zilliz console, recorded in run metadata
# NGRAM_MIN=2
# NGRAM_MAX=3
# TERMS_CSV=/path/to/terms.csv  # columns: term,popularity; replaces the synthetic generator
